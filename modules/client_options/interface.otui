OptionPanel
  Label
    width: 130
    id: layoutLabel
    !text: tr("Client layout (restart required)")
    $mobile:
      visible: false
  
  ComboBox
    id: layout
    margin-top: 3
    margin-right: 2
    margin-left: 2
    $mobile:
      visible: false
    @onOptionChange: modules.client_options.setOption(self:getId(), self:getCurrentOption().data)
    @onSetup: |
      self:addOption(tr("Classic 8.60"), "classic")
      self:addOption(tr("OTCv8 Retro (Kondrah)"), "retro")

  OptionCheckBox
    id: mapView
    !text: tr('Map view')
    margin-top: 5
    visible: false
    
    $mobile:
      visible: false

  OptionCheckBox
    id: cacheMap
    visible: false
    !text: tr('Cache map (for non-classic view)')

    $mobile:
      visible: false

  FlatPanel
    height: 22

    OptionCheckBox
      id: showPing
      !text: tr('Show ping')
      !tooltip: tr('Display connection speed to the server (milliseconds)')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin: 5

  FlatPanel
    height: 22
    margin-top: 8

    OptionCheckBox
      id: displayNames
      !text: tr('Display creature names')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin: 5

  FlatPanel
    height: 22
    margin-top: 8

    OptionCheckBox
      id: displayHealth
      !text: tr('Display creature health bars')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin: 5

  FlatPanel
    height: 22
    margin-top: 8

    OptionCheckBox
      id: displayHealthOnTop
      !text: tr('Display creature health bars above texts')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin: 5

  FlatPanel
    height: 22
    margin-top: 8

    OptionCheckBox
      id: displayMana
      !text: tr('Show player mana bar')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin: 5
