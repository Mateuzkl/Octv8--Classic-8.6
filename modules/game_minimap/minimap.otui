MinimapFlag < UIWidget
  size: 11 11
  focusable: false

MinimapCross < UIWidget
  focusable: false
  phantom: true
  image: /images/game/minimap/cross
  size: 16 16

MinimapFloorUpButton < Button
  size: 20 20
  margin-right: 28
  margin-bottom: 28
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  icon-source: /images/game/minimap/floor_up
  icon-clip: 0 32 16 16
  $pressed:
    icon-clip: 0 0 16 16
  $hover !pressed:
    icon-clip: 0 16 16 16

MinimapFloorDownButton < Button
  size: 20 20
  margin-right: 28
  margin-bottom: 4
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  icon-source: /images/game/minimap/floor_down
  icon-clip: 0 32 16 16
  $pressed:
    icon-clip: 0 0 16 16
  $hover !pressed:
    icon-clip: 0 16 16 16

MinimapZoomInButton < Button
  text: +
  size: 20 20
  margin-right: 4
  margin-bottom: 28
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  //icon-source: /images/game/minimap/zoom_in

MinimapZoomOutButton < Button
  text: -
  size: 20 20
  margin-right: 4
  margin-bottom: 4
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  //icon-source: /images/game/minimap/zoom_out

MinimapResetButton < Button
  !text: tr('Center')
  size: 44 20
  anchors.left: parent.left
  anchors.top: parent.top
  margin: 4

Minimap < UIMinimap
  draggable: true
  focusable: false
  cross: true
  color: black

// Minimap Flag Create Window

MinimapFlagCheckBox < CheckBox
  size: 16 16
  margin-left: 5
  image-source: /images/game/minimap/flagcheckbox
  image-size: 16 16
  image-border: 3
  image-color: 
  icon-source: /images/game/minimap/mapflags
  icon-size: 11 11
  icon-offset: 2 2
  anchors.left: prev.right
  anchors.top: prev.top
  $!checked:
    image-clip: 26 0 26 26
  $hover !checked:
    image-clip: 78 0 26 26
  $checked:
    image-clip: 0 0 26 26
  $hover checked:
    image-clip: 52 0 26 26

MinimapFlagWindow < MainWindow
  !text: tr('Edit Mark')
  size: 286 189

  Label
    !text: tr('Position') .. ':'
    text-auto-resize: true
    anchors.top: parent.top
    visible: false
    anchors.left: parent.left

  Label
    id: position
    visible: false
    text-auto-resize: true
    anchors.top: parent.top
    anchors.right: parent.right

  Label
    !text: tr('Enter a short description') .. ':'
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: -18

  TextEdit
    id: description
    margin-top: 3
    anchors.left: parent.left
    anchors.top: prev.bottom
    anchors.right: parent.right

  Label
    !text: tr('Select a type') .. ':'
    margin-top: 12
    anchors.left: parent.left
    anchors.top: prev.bottom
    anchors.right: parent.right

  MinimapFlagCheckBox
    id: flag0
    icon-source: /images/game/minimap/flag0
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 5
    margin-left: 0  

  MinimapFlagCheckBox
    id: flag1
    icon-source: /images/game/minimap/flag1

  MinimapFlagCheckBox
    id: flag2
    icon-source: /images/game/minimap/flag2

  MinimapFlagCheckBox
    id: flag3
    icon-source: /images/game/minimap/flag3

  MinimapFlagCheckBox
    id: flag4
    icon-source: /images/game/minimap/flag4

  MinimapFlagCheckBox
    id: flag5
    icon-source: /images/game/minimap/flag5

  MinimapFlagCheckBox
    id: flag6
    icon-source: /images/game/minimap/flag6

  MinimapFlagCheckBox
    id: flag7
    icon-source: /images/game/minimap/flag7

  MinimapFlagCheckBox
    id: flag8
    icon-source: /images/game/minimap/flag8

  MinimapFlagCheckBox
    id: flag9
    icon-source: /images/game/minimap/flag9

  MinimapFlagCheckBox
    id: flag10
    icon-source: /images/game/minimap/flag10
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 5
    margin-left: 0  

  MinimapFlagCheckBox
    id: flag11
    icon-source: /images/game/minimap/flag11

  MinimapFlagCheckBox
    id: flag12
    icon-source: /images/game/minimap/flag12

  MinimapFlagCheckBox
    id: flag13
    icon-source: /images/game/minimap/flag13

  MinimapFlagCheckBox
    id: flag14
    icon-source: /images/game/minimap/flag14

  MinimapFlagCheckBox
    id: flag15
    icon-source: /images/game/minimap/flag15

  MinimapFlagCheckBox
    id: flag16
    icon-source: /images/game/minimap/flag16

  MinimapFlagCheckBox
    id: flag17
    icon-source: /images/game/minimap/flag17

  MinimapFlagCheckBox
    id: flag18
    icon-source: /images/game/minimap/flag18

  MinimapFlagCheckBox
    id: flag19
    icon-source: /images/game/minimap/flag19

  HorizontalSeparator
    anchors.right: parent.right
    anchors.left: parent.left
    anchors.bottom: next.top
    margin-bottom: 8

  Button
    id: okButton
    !text: tr('Ok')
    width: 43
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 10

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 43
    anchors.right: parent.right
    anchors.bottom: parent.bottom

InvisibleMinimapButton < UIButton
  opacity: 0
  size: 15 15

NonClosableMiniWindow
  height: 117
  id: minimapWindow
  @onClose: modules.game_minimap.onMiniWindowClose()
  &save: true
  &autoOpen: 3

  NonClosableMiniWindowContents
    anchors.fill: parent
    anchors.right: parent.right
    margin-top: 4
    margin-left: 4
    margin-right: 2
    image-source: /images/ui/panel_flat
    image-border: 1
    image-size: 108 108

    Minimap
      id: minimap
      margin-top: 1
      margin-left: 1
      width: 106
      height: 106
      anchors.left: parent.left
      anchors.top: parent.top

      UIButton
        id: minimapMoveLeft
        size: 20 20
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2
        image-source: /images/ui/arrow-left-button
        image-clip: 0 20 20 20
        opacity: 0.45
        !tooltip: tr('Move minimap left')
        @onClick: modules.game_minimap.moveMinimapLeft()

        $hover:
          opacity: 1.0

        $disabled:
          image-clip: 0 0 20 20
          opacity: 0.25

        $pressed:
          image-clip: 0 40 20 20

      UIButton
        id: minimapMoveRight
        size: 20 20
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 2
        image-source: /images/ui/arrow-right-button
        image-clip: 0 20 20 20
        opacity: 0.45
        !tooltip: tr('Move minimap right')
        @onClick: modules.game_minimap.moveMinimapRight()

        $hover:
          opacity: 1.0

        $disabled:
          image-clip: 0 0 20 20
          opacity: 0.25

        $pressed:
          image-clip: 0 40 20 20

      // --- Wide (2-column) controls, anchored to the map corners. Hidden in 1-column. ---
      MinimapResetButton
        id: resetWidget
        visible: false
        !text: tr('Center')
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 4
        margin-top: 4
        @onClick: self:getParent():reset()

      UIButton
        id: floorUpWidget
        visible: false
        image-source: /images/game/minimap/floor_up
        image-clip: 0 0 20 20
        size: 20 20
        anchors.right: parent.right
        anchors.top: parent.top
        margin-right: 4
        margin-top: 4
        @onClick: self:getParent():floorUp(1)
        $pressed:
          image-clip: 0 20 20 20

      UIButton
        id: floorDownWidget
        visible: false
        image-source: /images/game/minimap/floor_down
        image-clip: 0 0 20 20
        size: 20 20
        anchors.right: parent.right
        anchors.top: floorUpWidget.bottom
        margin-right: 4
        margin-top: 2
        @onClick: self:getParent():floorDown(1)
        $pressed:
          image-clip: 0 20 20 20

      UIButton
        id: zoomOutWidget
        visible: false
        image-source: /images/game/minimap/zoom-out
        image-clip: 0 0 20 20
        size: 20 20
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-right: 4
        margin-bottom: 4
        @onClick: self:getParent():zoomOut()
        $pressed:
          image-clip: 0 20 20 20

      UIButton
        id: zoomInWidget
        visible: false
        image-source: /images/game/minimap/zoom-in
        image-clip: 0 0 20 20
        size: 20 20
        anchors.right: parent.right
        anchors.bottom: zoomOutWidget.top
        margin-right: 4
        margin-bottom: 2
        @onClick: self:getParent():zoomIn()
        $pressed:
          image-clip: 0 20 20 20

    // --- Compact (1-column / original) controls. Hidden in 2-column. ---
    UIWidget
      id: circle
      image-source: /images/game/minimap/circle
      anchors.left: minimap.right
      anchors.top: minimap.top
      size: 43 43
      margin-left: 10

    InvisibleMinimapButton
      id: panLeft
      anchors.right: circle.right
      anchors.verticalCenter: circle.verticalCenter
      @onClick: self:getParent().minimap:move(-10, 0)

    InvisibleMinimapButton
      id: panRight
      anchors.left: circle.left
      anchors.verticalCenter: circle.verticalCenter
      @onClick: self:getParent().minimap:move(10, 0)

    InvisibleMinimapButton
      id: panUp
      anchors.top: circle.top
      anchors.horizontalCenter: circle.horizontalCenter
      @onClick: self:getParent().minimap:move(0, 10)

    InvisibleMinimapButton
      id: panDown
      anchors.bottom: circle.bottom
      anchors.horizontalCenter: circle.horizontalCenter
      @onClick: self:getParent().minimap:move(0, -10)

    InvisibleMinimapButton
      id: panReset
      anchors.verticalCenter: circle.verticalCenter
      anchors.horizontalCenter: circle.horizontalCenter
      @onClick: self:getParent().minimap:reset()

    UIButton
      id: compactZoomOut
      image-source: /images/game/minimap/zoom-out
      image-clip: 0 0 20 20
      anchors.left: circle.left
      anchors.top: circle.bottom
      size: 20 20
      margin-top: 2
      @onClick: self:getParent().minimap:zoomOut()
      $pressed:
        image-clip: 0 20 20 20

    UIButton
      id: compactZoomIn
      image-source: /images/game/minimap/zoom-in
      image-clip: 0 0 20 20
      size: 20 20
      anchors.left: prev.left
      anchors.top: prev.bottom
      margin-top: 3
      @onClick: self:getParent().minimap:zoomIn()
      $pressed:
        image-clip: 0 20 20 20

    UIButton
      id: compactFloorUp
      image-source: /images/game/minimap/floor_up
      image-clip: 0 0 20 20
      size: 20 20
      anchors.right: circle.right
      anchors.top: circle.bottom
      margin-top: 3
      @onClick: self:getParent().minimap:floorUp(1)
      $pressed:
        image-clip: 0 20 20 20

    UIButton
      id: compactFloorDown
      image-source: /images/game/minimap/floor_down
      image-clip: 0 0 20 20
      size: 20 20
      anchors.left: prev.left
      anchors.top: prev.bottom
      margin-top: 2
      @onClick: self:getParent().minimap:floorDown(1)
      $pressed:
        image-clip: 0 20 20 20

    Button
      id: compactCentre
      !text: tr('Centre')
      anchors.left: circle.left
      anchors.top: prev.bottom
      anchors.right: prev.right
      margin-top: 2
      @onClick: self:getParent().minimap:reset()

    UIButton
      id: bigMapButton
      size: 20 20
      anchors.right: prev.left
      anchors.top: prev.top
      margin-top: 5
      margin-right: 11
      !tooltip: tr('Open big minimap')
      icon-source: /images/topbuttons/bigmap
      icon-clip: 0 0 20 20
      @onClick: modules.game_minimap_big.toggle()

      $on:
        icon-clip: 20 0 20 20

      $pressed:
        icon-clip: 20 0 20 20
