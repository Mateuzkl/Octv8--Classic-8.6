ElfHotkeysCloseButton < UIButton
  size: 12 12
  image-source: /images/ui/miniwindow_buttons
  image-clip: 29 1 12 12

  $hover:
    image-clip: 29 15 12 12

  $pressed:
    image-clip: 29 29 12 12

ElfHotkeyRow < Panel
  height: 30
  margin-left: 2
  margin-right: 2

  CheckBox
    id: enabled
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 18
    height: 18

  Button
    id: keyButton
    anchors.left: enabled.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    width: 58
    height: 20
    text: Set key

  TextEdit
    id: name
    anchors.left: keyButton.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    width: 126
    height: 20
    text-align: left

  TextEdit
    id: script
    anchors.left: name.right
    anchors.right: editButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    margin-right: 4
    height: 20
    text-align: left

  Button
    id: editButton
    anchors.right: removeButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    width: 38
    height: 20
    text: Edit

  Button
    id: removeButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 20
    height: 20
    text: X

ElfHotkeysWindow < MainWindow
  id: elfHotkeysWindow
  text: Custom Hotkeys
  size: 600 420
  visible: false
  @onEscape: self:hide()

  ElfHotkeysCloseButton
    id: titleCloseButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -29
    margin-right: -9

  Panel
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 46

    CheckBox
      id: masterEnabled
      anchors.top: parent.top
      anchors.left: parent.left
      width: 132
      height: 20
      text: Hotkeys enabled

    CheckBox
      id: persistent
      anchors.top: parent.top
      anchors.left: masterEnabled.right
      margin-left: 10
      width: 92
      height: 20
      text: Persistent

    Button
      id: addButton
      anchors.top: parent.top
      anchors.right: parent.right
      width: 106
      height: 22
      text: Create Hotkey

    Label
      id: captureLabel
      anchors.top: masterEnabled.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      height: 16
      text: Click a key field, then press a key.
      color: #d7dce1
      font: verdana-11px-rounded

  HorizontalSeparator
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4

  Panel
    id: columnHeader
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20
    margin-top: 4

    Label
      id: stateHeader
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 84
      text: On
      color: #d7dce1
      font: verdana-11px-rounded

    Label
      id: nameHeader
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      width: 126
      text: Name
      color: #d7dce1
      font: verdana-11px-rounded

    Label
      id: scriptHeader
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      text: Script
      color: #d7dce1
      font: verdana-11px-rounded

  VerticalScrollBar
    id: hotkeyScroll
    anchors.top: columnHeader.bottom
    anchors.right: parent.right
    anchors.bottom: footer.top
    margin-top: 4
    margin-bottom: 4
    step: 30
    pixels-scroll: true

  ScrollablePanel
    id: hotkeyList
    anchors.top: columnHeader.bottom
    anchors.left: parent.left
    anchors.right: hotkeyScroll.left
    anchors.bottom: footer.top
    margin-top: 4
    margin-right: 4
    margin-bottom: 4
    background-color: #4e4e4e
    border-width: 1
    border-color: #676d75
    padding-left: 3
    padding-right: 3
    padding-top: 2
    padding-bottom: 2
    vertical-scrollbar: hotkeyScroll
    layout:
      type: verticalBox
      spacing: 2

  Panel
    id: footer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 24

    Label
      id: status
      anchors.left: parent.left
      anchors.right: saveButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      text: Disabled
      color: #ff5555
      font: verdana-11px-rounded

    Button
      id: saveButton
      anchors.right: closeButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      width: 72
      height: 20
      text: Save

    Button
      id: closeButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 72
      height: 20
      text: Close
