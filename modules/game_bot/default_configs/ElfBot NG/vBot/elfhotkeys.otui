ElfHotkeysCloseButton < UIButton
  size: 12 12
  image-source: /images/ui/miniwindow_buttons
  image-clip: 29 1 12 12

  $hover:
    image-clip: 29 15 12 12

  $pressed:
    image-clip: 29 29 12 12

ElfHotkeyRow < Panel
  height: 30
  margin-left: 2
  margin-right: 2

  CheckBox
    id: enabled
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 18
    height: 18

  Button
    id: keyButton
    anchors.left: enabled.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    width: 46
    height: 20
    text: Set key

  TextEdit
    id: name
    anchors.left: keyButton.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    margin-right: 3
    height: 20
    text-align: left

ElfHotkeysWindow < MainWindow
  id: elfHotkeysWindow
  text: Custom Hotkeys
  size: 520 430
  visible: false
  @onEscape: self:hide()

  ElfHotkeysCloseButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -29
    margin-right: -9

  Panel
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 46

    Label
      id: listLabel
      anchors.top: parent.top
      anchors.left: parent.left
      height: 16
      text: Hotkey List
      color: #d7dce1
      font: verdana-11px-rounded

    CheckBox
      id: masterEnabled
      anchors.top: listLabel.bottom
      anchors.left: parent.left
      margin-top: 2
      width: 132
      height: 20
      text: Hotkeys enabled

    CheckBox
      id: persistent
      anchors.top: listLabel.bottom
      anchors.left: masterEnabled.right
      margin-left: 10
      margin-top: 2
      width: 76
      height: 20
      text: Persistent

    Button
      id: editButton
      anchors.top: listLabel.bottom
      anchors.left: persistent.right
      margin-left: 10
      margin-top: 2
      width: 58
      height: 22
      text: Edit

    Button
      id: addButton
      anchors.top: listLabel.bottom
      anchors.left: editButton.right
      margin-left: 10
      margin-top: 2
      width: 106
      height: 22
      text: Create Hotkey

    Label
      id: captureLabel
      visible: false
      text: Click a key field, then press a key.

  HorizontalSeparator
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4

  VerticalScrollBar
    id: hotkeyScroll
    anchors.top: prev.bottom
    anchors.right: parent.right
    anchors.bottom: footer.top
    margin-top: 4
    margin-bottom: 4
    step: 30
    pixels-scroll: true

  ScrollablePanel
    id: hotkeyList
    anchors.top: prev.top
    anchors.left: parent.left
    anchors.right: hotkeyScroll.left
    anchors.bottom: footer.top
    margin-right: 4
    margin-bottom: 4
    background-color: #4e4e4e
    border-width: 1
    border-color: #676d75
    padding-left: 3
    padding-right: 3
    padding-top: 2
    padding-bottom: 2
    vertical-scrollbar: hotkeyScroll
    layout:
      type: verticalBox
      spacing: 1

  Panel
    id: footer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 24

    Label
      id: status
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      text: Disabled
      color: #ff5555
      font: verdana-11px-rounded
