ElfHotkeysWindow < MainWindow
  id: elfHotkeysWindow
  text: ElfBot Hotkeys Original
  size: 560 310
  @onEscape: self:hide()

  Label
    id: info
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 34
    margin-right: 28
    text-wrap: true
    text-align: center
    text: Cole as hotkeys ElfBot na caixa abaixo. Use presets ou cole manualmente, depois clique Ligar.

  Button
    id: closeButton
    text: X
    anchors.top: parent.top
    anchors.right: parent.right
    width: 24
    height: 20
    @onClick: modules.game_bot.elfHotkeysClose()

  HorizontalSeparator
    anchors.top: info.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5

  Label
    id: status
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20
    margin-top: 5
    text-align: center
    text: Status: desligado
    color: red

  Button
    id: editScripts
    text: Editar/Clicar aqui
    anchors.top: status.bottom
    anchors.left: parent.left
    margin-top: 8
    width: 120
    height: 22
    @onClick: modules.game_bot.elfHotkeysEdit()

  Button
    id: toggleScripts
    text: Ligar
    anchors.top: editScripts.top
    anchors.left: editScripts.right
    margin-left: 5
    width: 80
    height: 22
    @onClick: modules.game_bot.elfHotkeysToggle()

  Button
    id: saveScripts
    text: Salvar
    anchors.top: editScripts.top
    anchors.left: toggleScripts.right
    margin-left: 5
    width: 80
    height: 22
    @onClick: modules.game_bot.elfHotkeysSave()

  Button
    id: stopScripts
    text: Desligar
    anchors.top: editScripts.top
    anchors.left: saveScripts.right
    margin-left: 5
    width: 80
    height: 22
    @onClick: modules.game_bot.elfHotkeysStop()

  Label
    id: presetLabel
    text: Presets:
    anchors.top: editScripts.bottom
    anchors.left: parent.left
    margin-top: 10
    width: 70
    height: 20

  Button
    id: knightPreset
    text: Knight
    anchors.top: presetLabel.bottom
    anchors.left: parent.left
    margin-top: 4
    width: 80
    height: 22
    @onClick: modules.game_bot.elfHotkeysLoadPreset('knight')

  Button
    id: druidPreset
    text: Druid
    anchors.top: knightPreset.top
    anchors.left: knightPreset.right
    margin-left: 5
    width: 80
    height: 22
    @onClick: modules.game_bot.elfHotkeysLoadPreset('druid')

  Button
    id: paladinPreset
    text: Paladin
    anchors.top: knightPreset.top
    anchors.left: druidPreset.right
    margin-left: 5
    width: 80
    height: 22
    @onClick: modules.game_bot.elfHotkeysLoadPreset('paladin')

  Button
    id: sorcererPreset
    text: Sorcerer
    anchors.top: knightPreset.top
    anchors.left: paladinPreset.right
    margin-left: 5
    width: 80
    height: 22
    @onClick: modules.game_bot.elfHotkeysLoadPreset('sorcerer')

  Button
    id: diversasPreset
    text: Diversas
    anchors.top: knightPreset.top
    anchors.left: sorcererPreset.right
    margin-left: 5
    width: 80
    height: 22
    @onClick: modules.game_bot.elfHotkeysLoadPreset('diversas')

  TextEdit
    id: preview
    anchors.top: knightPreset.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8
    editable: true
    text-align: left
    text-wrap: true
    text:
