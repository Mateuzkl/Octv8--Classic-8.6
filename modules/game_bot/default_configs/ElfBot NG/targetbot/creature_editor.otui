TargetBotCreatureEditorScrollBar < Panel
  height: 30
  margin-top: 5
  margin-left: 8
  margin-right: 8

  Label
    id: text
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    text-align: center

  HorizontalScrollBar
    id: scroll
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 3
    minimum: 0
    maximum: 10
    step: 1

TargetBotCreatureEditorTextEdit < Panel
  height: 43
  margin-top: 5
  margin-left: 8
  margin-right: 8

  Label
    id: text
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    text-align: left

  TextEdit
    id: textEdit
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 4
    height: 20

TargetBotCreatureEditorItem < Panel
  height: 36
  margin-top: 5
  margin-left: 8
  margin-right: 8

  Label
    id: text
    anchors.left: parent.left
    anchors.verticalCenter: next.verticalCenter

  BotItem
    id: item
    anchors.top: parent.top
    anchors.right: parent.right

TargetBotCreatureEditorCheckBox < BotSwitch
  height: 22
  margin-top: 5
  margin-left: 8
  margin-right: 8
  text-align: center

TargetBotClassicGroup < Panel
  image-source: /images/ui/panel_flat
  image-border: 1

  Label
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 5
    margin-left: 8
    text-auto-resize: true

TargetBotCreatureEditorWindow < MainWindow
  text: Monster Targeting
  width: 710
  height: 540

  $mobile:
    height: 420

  Panel
    id: rootPanel
    anchors.fill: parent
    margin: 2

    Label
      id: heading
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 8
      margin-left: 10
      text: Monsters definition and behaviours
      text-auto-resize: true

    Panel
      id: namePanel
      anchors.top: heading.bottom
      anchors.left: parent.left
      anchors.right: parent.horizontalCenter
      margin-top: 8
      margin-left: 10
      margin-right: 8
      height: 72
      image-source: /images/ui/panel_flat
      image-border: 1

      Label
        id: nameLabel
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 10
        margin-left: 10
        text: Name
        text-auto-resize: true

      TextEdit
        id: name
        anchors.top: nameLabel.top
        anchors.left: nameLabel.right
        anchors.right: parent.right
        margin-left: 10
        margin-right: 10
        height: 20

      Label
        id: hint
        anchors.top: name.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        margin-left: 10
        margin-right: 10
        text: Use * and ? wildcards. Separate multiple targets with comma.
        text-auto-resize: true

    TargetBotClassicGroup
      id: selectionGroup
      anchors.top: heading.bottom
      anchors.left: parent.horizontalCenter
      anchors.right: parent.right
      anchors.bottom: optionsGroup.top
      margin-top: 8
      margin-left: 8
      margin-right: 10
      margin-bottom: 8

      @onSetup: self.title:setText('Target behaviour')

      ScrollablePanel
        id: right
        anchors.top: title.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 4
        margin-right: 16
        vertical-scrollbar: rightScroll
        layout:
          type: verticalBox
          fit-children: true

      VerticalScrollBar
        id: rightScroll
        anchors.top: right.top
        anchors.bottom: right.bottom
        anchors.right: parent.right
        margin-right: 2
        step: 28
        pixels-scroll: true

    TargetBotClassicGroup
      id: priorityGroup
      anchors.top: namePanel.bottom
      anchors.left: parent.left
      anchors.right: parent.horizontalCenter
      anchors.bottom: optionsGroup.top
      margin-top: 8
      margin-left: 10
      margin-right: 8
      margin-bottom: 8

      @onSetup: self.title:setText('Target selection')

      ScrollablePanel
        id: left
        anchors.top: title.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 4
        vertical-scrollbar: leftScroll
        layout:
          type: verticalBox
          fit-children: true

      VerticalScrollBar
        id: leftScroll
        anchors.top: left.top
        anchors.bottom: left.bottom
        anchors.right: parent.right
        margin-right: 2
        step: 28
        pixels-scroll: true

    TargetBotClassicGroup
      id: optionsGroup
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: buttonsPanel.top
      margin-left: 10
      margin-right: 10
      margin-bottom: 8
      height: 82

      @onSetup: self.title:setText('Saving & Loading settings')

      Button
        id: help
        !text: tr('Help & Tutorials')
        anchors.top: title.bottom
        anchors.left: parent.left
        margin-top: 10
        margin-left: 10
        width: 170
        @onClick: g_platform.openUrl("http://bot.otclient.ovh/")

      Label
        id: saveHint
        anchors.top: title.bottom
        anchors.left: help.right
        anchors.right: parent.right
        margin-top: 13
        margin-left: 12
        margin-right: 10
        text: Press Ok to save this monster behaviour.
        text-auto-resize: true

    Panel
      id: buttonsPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 10
      margin-right: 10
      margin-bottom: 8
      height: 26

      Button
        id: ok
        !text: tr('Ok')
        anchors.top: parent.top
        anchors.right: cancel.left
        margin-right: 10
        width: 76

      Button
        id: cancel
        !text: tr('Cancel')
        anchors.top: parent.top
        anchors.right: parent.right
        width: 76
