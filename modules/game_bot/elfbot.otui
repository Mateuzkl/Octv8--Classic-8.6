MiniWindow
  id: elfBotWindow
  text: ElfBot NG 4.5.9 - Startup - 0 ms - 0 exp/hour
  width: 455
  height: 122
  @onClose: modules.game_bot.onElfMiniWindowClose()
  &save: true
  &autoOpen: 1

  MiniWindowContents
    Button
      id: healingButton
      text: Healing
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 5
      margin-top: 4
      size: 72 18
      @onClick: modules.game_bot.elfButton('Healing')

    Button
      id: aimbotButton
      text: Aimbot
      anchors.left: healingButton.right
      anchors.top: healingButton.top
      margin-left: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('Aimbot')

    Button
      id: listsButton
      text: Lists
      anchors.left: aimbotButton.right
      anchors.top: healingButton.top
      margin-left: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('Lists')

    Button
      id: hudButton
      text: HUD
      anchors.left: listsButton.right
      anchors.top: healingButton.top
      margin-left: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('HUD')

    Button
      id: profile1Button
      text: 1
      anchors.left: hudButton.right
      anchors.top: healingButton.top
      margin-left: 8
      size: 22 18
      @onClick: modules.game_bot.elfProfile(1)

    Button
      id: profile2Button
      text: 2
      anchors.left: profile1Button.right
      anchors.top: healingButton.top
      margin-left: 2
      size: 22 18
      @onClick: modules.game_bot.elfProfile(2)

    Button
      id: profile3Button
      text: 3
      anchors.left: profile2Button.right
      anchors.top: healingButton.top
      margin-left: 2
      size: 22 18
      @onClick: modules.game_bot.elfProfile(3)

    Button
      id: profile4Button
      text: 4
      anchors.left: profile3Button.right
      anchors.top: healingButton.top
      margin-left: 2
      size: 22 18
      @onClick: modules.game_bot.elfProfile(4)

    Button
      id: profile5Button
      text: 5
      anchors.left: profile4Button.right
      anchors.top: healingButton.top
      margin-left: 2
      size: 22 18
      @onClick: modules.game_bot.elfProfile(5)

    Button
      id: extrasButton
      text: Extras
      anchors.left: parent.left
      anchors.top: healingButton.bottom
      margin-left: 5
      margin-top: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('Extras')

    Button
      id: hotkeysButton
      text: Hotkeys
      anchors.left: extrasButton.right
      anchors.top: extrasButton.top
      margin-left: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('Hotkeys')

    Button
      id: shortkeysButton
      text: Shortkeys
      anchors.left: hotkeysButton.right
      anchors.top: extrasButton.top
      margin-left: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('Shortkeys')

    Button
      id: reconnectButton
      text: Reconnect
      anchors.left: shortkeysButton.right
      anchors.top: extrasButton.top
      margin-left: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('Reconnect')

    Button
      id: saveButton
      text: Save
      anchors.left: reconnectButton.right
      anchors.top: extrasButton.top
      margin-left: 2
      size: 55 18
      @onClick: modules.game_bot.elfButton('Save')

    Button
      id: customButton
      text: Custom
      anchors.left: saveButton.right
      anchors.top: extrasButton.top
      margin-left: 2
      size: 64 18
      @onClick: modules.game_bot.elfButton('Custom')

    Button
      id: cavebotButton
      text: Cavebot
      anchors.left: parent.left
      anchors.top: extrasButton.bottom
      margin-left: 5
      margin-top: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('Cavebot')

    Button
      id: navigationButton
      text: Navigation
      anchors.left: cavebotButton.right
      anchors.top: cavebotButton.top
      margin-left: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('Navigation')

    Button
      id: linksButton
      text: Links
      anchors.left: navigationButton.right
      anchors.top: cavebotButton.top
      margin-left: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('Links')

    Button
      id: creatureSpyButton
      text: Creature Spy
      anchors.left: linksButton.right
      anchors.top: cavebotButton.top
      margin-left: 2
      size: 92 18
      @onClick: modules.game_bot.elfButton('Creature Spy')

    Button
      id: loadButton
      text: Load
      anchors.left: creatureSpyButton.right
      anchors.top: cavebotButton.top
      margin-left: 2
      size: 55 18
      @onClick: modules.game_bot.elfButton('Load')

    Button
      id: helpButton
      text: Help
      anchors.left: loadButton.right
      anchors.top: cavebotButton.top
      margin-left: 2
      size: 55 18
      @onClick: modules.game_bot.elfButton('Help')

    Button
      id: targetingButton
      text: Targeting
      anchors.left: parent.left
      anchors.top: cavebotButton.bottom
      margin-left: 5
      margin-top: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('Targeting')

    Button
      id: proxyButton
      text: Proxy
      anchors.left: targetingButton.right
      anchors.top: targetingButton.top
      margin-left: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('Proxy')

    Button
      id: iconsButton
      text: Icons
      anchors.left: proxyButton.right
      anchors.top: targetingButton.top
      margin-left: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('Icons')

    Button
      id: pvpButton
      text: PVP
      anchors.left: iconsButton.right
      anchors.top: targetingButton.top
      margin-left: 2
      size: 72 18
      @onClick: modules.game_bot.elfButton('PVP')
